{
  "$schema": "./building_sprite_map.schema.json",
  "schema_version": 1,
  "contract_id": "building_sprite_map.v1",
  "contract_version": 1,
  "status": "frozen",
  "canvas": {
    "width": 1536,
    "height": 1024,
    "format": "PNG",
    "color_mode": "RGBA",
    "color_space": "sRGB",
    "background": "fully_transparent",
    "grid": {
      "columns": 3,
      "rows": 2,
      "slot_width": 512,
      "slot_height": 512,
      "gutter": 0
    },
    "fallback_generation_size": {
      "width": 3072,
      "height": 2048,
      "downscale_percent": 50,
      "rule": "downscale_exactly; never crop, pad, stretch, or scale non-uniformly"
    }
  },
  "geometry": {
    "world_cell_px_at_2x": 128,
    "anchor": {
      "x": 256,
      "y": 464
    },
    "safe_padding_px": 32,
    "safe_bounds": {
      "x1": 32,
      "y1": 32,
      "x2": 480,
      "y2": 480
    },
    "shadow_limit_y": 480,
    "responsive_proof_cell_px": [
      38,
      48,
      64
    ]
  },
  "camera": {
    "view": "three_quarter_front",
    "viewer_position": "south_looking_north_and_down",
    "south_faces_parallel_to_canvas": true,
    "perspective_convergence": false,
    "vertical_edges_vertical": true,
    "footprint_projection": "screen_space_rectangle"
  },
  "lighting": {
    "key_direction": "upper_left_north_west",
    "cast_shadow_direction": "lower_right",
    "single_shared_angle": true
  },
  "outline": {
    "unit": "source_px_at_2x",
    "minimum": 4,
    "maximum": 8,
    "rule": "Choose one weight in this range per theme map and use it consistently on all six buildings."
  },
  "alpha_edge_rules": {
    "background_alpha": 0,
    "background_rgb_when_alpha_zero": [
      0,
      0,
      0
    ],
    "allow_partial_alpha_for": [
      "anti_aliased_object_edges",
      "ground_shadows"
    ],
    "semi_transparent_background_allowed": false,
    "matte_halo_allowed": false,
    "content_outside_safe_bounds_allowed": false
  },
  "overhang_profiles": {
    "2x2": {
      "top_cells": 1.0,
      "top_px": 128
    },
    "1x2": {
      "top_cells": 0.25,
      "top_px": 32
    },
    "1x1": {
      "top_cells": 0.75,
      "top_px": 96
    }
  },
  "theme_ids": [
    "perkampungan",
    "kingdom",
    "city"
