  "graybox_palette_rgba": {
    "mass": [150, 155, 160, 255],
    "footprint": [92, 132, 172, 255],
    "footprint_outline": [48, 76, 104, 255],
    "anchor": [205, 72, 112, 255],
    "entrance": [58, 156, 98, 255],
    "safe_padding": [112, 118, 124, 255],
    "shadow_limit": [72, 78, 84, 255]
  },
  "visual_checklist": {
    "shared": [
      "Reads as a friendly children's product at 38, 48, and 64 px per world cell.",
      "Uses the theme's material language without changing silhouette scale, footprint, anchor, entrance, camera, or light.",
      "Contains no currency symbols, coins, banknotes, prices, payment terminals, cash registers, advertising, brand marks, or payout cues.",
      "Uses no baked-in words or labels; meaning comes from silhouette and objects.",
      "Keeps entrances and connection ends unobstructed and readable.",
      "Receives human Indonesian cultural review; automated validation does not approve cultural accuracy."
    ],
    "per_building": {
      "starter_house": {
        "theme_variants": {"kingdom": "Keeper's Cottage", "city": "Colorful Townhouse", "perkampungan": "Rumah Kampung"},
        "required_cues": ["safe welcoming home", "clear south door", "first-achievement landmark"],
        "prohibited_cues": ["money or payout", "shopfront", "production machinery", "damage or danger"]
      },
      "garden": {
        "theme_variants": {"kingdom": "Royal Herb Garden", "city": "Community Garden", "perkampungan": "Kebun Tunas"},
        "required_cues": ["countable planting groups", "accessible plot boundary", "clear south entrance"],
        "prohibited_cues": ["money or payout", "sale signs", "hazardous tools", "unreadable dense foliage"]
      },
      "bakery": {
        "theme_variants": {"kingdom": "Castle Bakehouse", "city": "City Bakery", "perkampungan": "Warung Roti"},
        "required_cues": ["bread or oven purpose without text", "clear south door", "friendly food preparation"],
        "prohibited_cues": ["money or prices", "brands or advertising", "dangerous open flames", "factory-scale machinery"]
      },
      "park": {
        "theme_variants": {"kingdom": "Royal Garden", "city": "City Park", "perkampungan": "Lapangan Kampung"},
        "required_cues": ["open community space", "pattern-friendly arrangement", "clear south entrance"],
        "prohibited_cues": ["money or payout", "vendor or shop cues", "production cues", "entrance-blocking decoration"]
      },
      "bridge": {
        "theme_variants": {"kingdom": "Stone Story Bridge", "city": "Pedestrian City Bridge", "perkampungan": "Jembatan Kayu-Bambu"},
        "required_cues": ["open north and south connection ends", "one-cell-wide two-cell-long deck", "water-safe pedestrian crossing"],
        "prohibited_cues": ["toll or money cues", "vehicle roadway", "blocked connection ends", "unsafe broken structure"]
      },
      "market_stall": {
        "theme_variants": {"kingdom": "Royal Bazaar Stall", "city": "City Kiosk", "perkampungan": "Kios Pasar"},
        "required_cues": ["countable displayed items", "small one-cell scale", "clear south entrance"],
        "prohibited_cues": ["currency or prices", "advertising or brands", "child trading or automatic payment", "casino or gambling cues"]
      }
    }
  },
  "generation": {
    "revision_policy": "Every revision outputs the complete six-slot map. Name the failing slot in feedback, but never transplant, independently rescale, crop, or patch a single building from another generation.",
    "required_provenance_fields": [
      "creator",
      "model_or_tool",
      "model_or_tool_version",
      "generation_date",
      "prompt_revision",
      "contract_id",
      "source_graybox",
      "seed_or_job_id",
      "rights_or_license_status",
      "human_cultural_review_status",
      "art_review_status",
      "post_generation_edits"
    ]
  }
