{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kidquest.local/content/kidquest/assets.schema.json",
  "title": "KidQuest theme asset manifest entry",
  "description": "One logical asset in one theme's manifest (pipeline section 14.3). Logical geometry (footprint, anchor, entrances, collision) comes from buildings.json and the layout and must not be redefined by a visual variant. Coordinates: cells are (x, y) with (0, 0) at the north-west corner, x growing east and y growing south. A footprint or rectangle position is its top-left (north-west) cell. Anchors and offsets are in cell units relative to that top-left cell; a building anchor is the bottom-centre of its footprint.",
  "schema_version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "category",
    "content_version",
    "required_in_themes",
    "runtime_path",
    "pixel_size",
    "css_cell_size",
    "layer",
    "alpha_required",
    "max_bytes",
    "export_profile",
    "source",
    "decorative"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+--[a-z0-9_]+$",
      "description": "Logical asset ID `{asset_id}--{variant}`, for example `starter_house--base` or `road_basic--mask_05`. The theme is the containing directory, never part of the ID."
    },
    "category": {
      "enum": ["terrain", "shore", "road", "building", "fixed_feature", "plant", "prop", "fence", "icon", "theme_selector"]
    },
    "content_version": {"type": "integer", "minimum": 1},
    "required_in_themes": {
      "type": "array",
      "items": {"enum": ["perkampungan", "kingdom", "city"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "runtime_path": {"type": "string", "pattern": "^static/images/kidquest/.+\\.(webp|png)$"},
    "fallback_path": {"type": ["string", "null"], "pattern": "^static/images/kidquest/.+\\.(webp|png)$"},
    "pixel_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    },
    "css_cell_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}
    },
    "footprint": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    },
    "anchor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
    },
    "overhang": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "top": {"type": "number", "minimum": 0},
        "left": {"type": "number", "minimum": 0},
        "right": {"type": "number", "minimum": 0}
      }
    },
    "collision_ref": {"type": ["string", "null"], "description": "Logical building or layout object whose collision applies, for example `buildings.json#starter_house`."},
    "entrances": {
      "type": ["array", "null"],
      "items": {"enum": ["N", "E", "S", "W"]},
      "uniqueItems": true
    },
    "layer": {"enum": ["terrain", "water_shore", "paths", "ground_shadows", "buildings", "props", "interaction_overlays"]},
    "z_offset": {"type": "integer"},
    "alpha_required": {"type": "boolean"},
    "max_bytes": {"type": "integer", "minimum": 1},
    "export_profile": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "creator", "license_status", "review_status", "checksum"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "license_status": {"type": "string", "minLength": 1},
        "review_status": {"enum": ["placeholder", "graybox", "in_review", "approved"]},
        "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "accessible_label_key": {"type": ["string", "null"]},
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_id", "theme_id", "contract_id", "source_map", "source_map_sha256", "source_provenance",
        "slot", "slot_rect", "footprint_rect", "anchor", "entrances", "collision_ref", "shadow_bounds",
        "accessible_label"
      ],
      "properties": {
        "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "theme_id": {"enum": ["perkampungan", "kingdom", "city"]},
        "contract_id": {"const": "building_sprite_map.v1"},
        "source_map": {"type": "string", "pattern": "^design/kidquest/sprite-maps/.+/buildings_v1\\.png$"},
        "source_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_provenance": {"type": "string", "pattern": "^design/kidquest/sprite-maps/.+/PROVENANCE\\.md$"},
        "slot": {"type": "integer", "minimum": 1, "maximum": 6},
        "slot_rect": {"$ref": "#/$defs/pixel_rect"},
        "footprint_rect": {"$ref": "#/$defs/bounds_rect"},
        "anchor": {"$ref": "#/$defs/point"},
        "entrances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["side", "x", "y"],
            "properties": {
              "side": {"enum": ["N", "E", "S", "W"]},
              "x": {"type": "integer"},
              "y": {"type": "integer"}
            }
          }
        },
        "collision_ref": {"type": "string", "pattern": "^buildings\\.json#[a-z][a-z0-9_]*$"},
        "shadow_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "integer"}, "y": {"type": "integer"},
            "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}
          }
        },
        "accessible_label": {"type": "string", "minLength": 1}
      }
    },
    "decorative": {"type": "boolean"}
  },
  "$defs": {
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}
    },
    "pixel_rect": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}
      }
    },
    "bounds_rect": {
      "type": "object", "additionalProperties": false, "required": ["x1", "y1", "x2", "y2"],
      "properties": {
        "x1": {"type": "integer"}, "y1": {"type": "integer"},
        "x2": {"type": "integer"}, "y2": {"type": "integer"}
      }
    }
  }
}
