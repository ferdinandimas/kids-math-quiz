{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kids-math-quiz.local/schemas/building_sprite_map.schema.json",
  "title": "KidQuest frozen building sprite-map contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "contract_id", "contract_version", "status", "canvas", "geometry", "camera", "lighting", "outline", "alpha_edge_rules", "overhang_profiles", "theme_ids", "slots", "graybox_palette_rgba", "visual_checklist", "generation"],
  "properties": {
    "$schema": {"const": "./building_sprite_map.schema.json"},
    "schema_version": {"const": 1},
    "contract_id": {"const": "building_sprite_map.v1"},
    "contract_version": {"const": 1},
    "status": {"const": "frozen"},
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "format", "color_mode", "color_space", "background", "grid", "fallback_generation_size"],
      "properties": {
        "width": {"const": 1536}, "height": {"const": 1024}, "format": {"const": "PNG"},
        "color_mode": {"const": "RGBA"}, "color_space": {"const": "sRGB"}, "background": {"const": "fully_transparent"},
        "grid": {
          "type": "object", "additionalProperties": false,
          "required": ["columns", "rows", "slot_width", "slot_height", "gutter"],
          "properties": {"columns": {"const": 3}, "rows": {"const": 2}, "slot_width": {"const": 512}, "slot_height": {"const": 512}, "gutter": {"const": 0}}
        },
        "fallback_generation_size": {
          "type": "object", "additionalProperties": false,
          "required": ["width", "height", "downscale_percent", "rule"],
          "properties": {"width": {"const": 3072}, "height": {"const": 2048}, "downscale_percent": {"const": 50}, "rule": {"type": "string", "minLength": 1}}
        }
      }
    },
    "geometry": {
      "type": "object", "additionalProperties": false,
      "required": ["world_cell_px_at_2x", "anchor", "safe_padding_px", "safe_bounds", "shadow_limit_y", "responsive_proof_cell_px"],
      "properties": {
        "world_cell_px_at_2x": {"const": 128}, "anchor": {"$ref": "#/$defs/anchor"}, "safe_padding_px": {"const": 32},
        "safe_bounds": {"type": "object", "additionalProperties": false, "required": ["x1", "y1", "x2", "y2"], "properties": {"x1": {"const": 32}, "y1": {"const": 32}, "x2": {"const": 480}, "y2": {"const": 480}}},
        "shadow_limit_y": {"const": 480}, "responsive_proof_cell_px": {"const": [38, 48, 64]}
      }
    },
    "camera": {"type": "object", "required": ["view", "viewer_position", "south_faces_parallel_to_canvas", "perspective_convergence", "vertical_edges_vertical", "footprint_projection"]},
    "lighting": {"type": "object", "required": ["key_direction", "cast_shadow_direction", "single_shared_angle"]},
    "outline": {
      "type": "object", "additionalProperties": false, "required": ["unit", "minimum", "maximum", "rule"],
      "properties": {"unit": {"const": "source_px_at_2x"}, "minimum": {"const": 4}, "maximum": {"const": 8}, "rule": {"type": "string", "minLength": 1}}
    },
    "alpha_edge_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["background_alpha", "background_rgb_when_alpha_zero", "allow_partial_alpha_for", "semi_transparent_background_allowed", "matte_halo_allowed", "content_outside_safe_bounds_allowed"],
      "properties": {
        "background_alpha": {"const": 0}, "background_rgb_when_alpha_zero": {"const": [0, 0, 0]},
        "allow_partial_alpha_for": {"const": ["anti_aliased_object_edges", "ground_shadows"]},
        "semi_transparent_background_allowed": {"const": false}, "matte_halo_allowed": {"const": false}, "content_outside_safe_bounds_allowed": {"const": false}
      }
    },
    "overhang_profiles": {"type": "object", "required": ["2x2", "1x2", "1x1"]},
    "theme_ids": {"const": ["perkampungan", "kingdom", "city"]},
    "slots": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/slot"}},
    "graybox_palette_rgba": {
      "type": "object", "required": ["mass", "footprint", "footprint_outline", "anchor", "entrance", "safe_padding", "shadow_limit"], "additionalProperties": false,
      "properties": {
        "mass": {"type": "array"}, "footprint": {"type": "array"}, "footprint_outline": {"type": "array"},
        "anchor": {"type": "array"}, "entrance": {"type": "array"}, "safe_padding": {"type": "array"}, "shadow_limit": {"type": "array"}
      }
    },
    "visual_checklist": {
      "type": "object", "additionalProperties": false, "required": ["shared", "per_building"],
      "properties": {
        "shared": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}},
        "per_building": {
          "type": "object", "required": ["starter_house", "garden", "bakery", "park", "bridge", "market_stall"], "additionalProperties": false,
          "properties": {
            "starter_house": {"type": "object"}, "garden": {"type": "object"}, "bakery": {"type": "object"},
            "park": {"type": "object"}, "bridge": {"type": "object"}, "market_stall": {"type": "object"}
          }
        }
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false, "required": ["revision_policy", "required_provenance_fields"],
      "properties": {"revision_policy": {"type": "string", "minLength": 1}, "required_provenance_fields": {"type": "array", "minItems": 11, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    }
  },
  "$defs": {
    "anchor": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"const": 256}, "y": {"const": 464}}},
    "point": {"type": "object", "additionalProperties": false, "required": ["side", "x", "y"], "properties": {"side": {"enum": ["N", "S"]}, "x": {"type": "integer"}, "y": {"type": "integer"}}},
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["slot", "row", "column", "rect", "logical_id", "footprint", "footprint_rect", "anchor", "entrances"],
      "properties": {
        "slot": {"type": "integer", "minimum": 1, "maximum": 6}, "row": {"type": "integer", "minimum": 1, "maximum": 2}, "column": {"type": "integer", "minimum": 1, "maximum": 3},
        "rect": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}, "width": {"const": 512}, "height": {"const": 512}}},
        "logical_id": {"enum": ["starter_house", "garden", "bakery", "park", "bridge", "market_stall"]},
        "footprint": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1, "maximum": 2}, "height": {"type": "integer", "minimum": 1, "maximum": 2}}},
        "long_axis": {"const": "north_south"},
        "footprint_rect": {"type": "object", "additionalProperties": false, "required": ["x1", "y1", "x2", "y2"], "properties": {"x1": {"type": "integer"}, "y1": {"type": "integer"}, "x2": {"type": "integer"}, "y2": {"type": "integer"}}},
        "anchor": {"$ref": "#/$defs/anchor"}, "entrances": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/point"}}
      }
    }
  }
}
